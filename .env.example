# ==========================================
# AI 赋能万象应用平台 - 环境变量配置模板
# ==========================================
# 使用方式：复制为 .env 并填入实际值
# cp .env.example .env
# ==========================================

# MySQL 数据库密码（默认 dev 密码 123456）
DB_PASSWORD=123456

# JWT 签名密钥（生产环境请使用随机字符串）
# Linux: openssl rand -base64 64
# Windows: 使用任意 64+ 字符随机字符串
JWT_SECRET=YOUR_RANDOM_JWT_SECRET_HERE

# DeepSeek AI 模型 API 配置
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat

# Python ML Server 地址
PYTHON_ML_URL=http://localhost:5001

# Redis 配置（可选）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
